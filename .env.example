PORT=5000
NODE_ENV=development

# En local (PostgreSQL installé sur ta machine)
DATABASE_URL="postgresql://postgres:password@localhost:5432/osumbises?schema=public"

# En ligne (ex. Neon, Supabase, Railway), remplace par ta chaîne de connexion
# DATABASE_URL="postgresql://<user>:<password>@<host>/osumbises?schema=public&sslmode=require"

# Origine du frontend Vite, nécessaire pour que le cookie HttpOnly fonctionne
CLIENT_URL=http://localhost:5173

JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=24h

PORT=5000
NODE_ENV=development

# En local (PostgreSQL installé sur ta machine)
DATABASE_URL="postgresql://postgres:password@localhost:5432/osumbises?schema=public"

# En ligne (ex. Neon, Supabase, Railway), remplace par ta chaîne de connexion
# DATABASE_URL="postgresql://<user>:<password>@<host>/osumbises?schema=public&sslmode=require"

# Origine du frontend Vite, nécessaire pour que le cookie HttpOnly fonctionne
CLIENT_URL=http://localhost:5173

JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=24h

# --- Airtel Money (paiement des abonnements) ---
# Renseigné une fois le compte développeur créé sur developers.airtel.africa
# et l'application enregistrée pour le Gabon (voir les étapes fournies).
AIRTEL_ENV=sandbox
# sandbox -> https://openapiuat.airtel.africa
# production -> https://openapi.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=GA
AIRTEL_CURRENCY=XAF
# URL publique où Airtel enverra la confirmation de paiement
AIRTEL_CALLBACK_URL=http://localhost:5000/api/webhooks/airtel-money
# Clé privée visible dans les paramètres de l'application sur le portail
# développeur Airtel — sert à vérifier l'authenticité des callbacks (HMAC-SHA256)
AIRTEL_CALLBACK_PRIVATE_KEY=

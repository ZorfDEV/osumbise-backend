generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SAAS / MULTI-TENANT
// ============================================================

model Organization {
  id             String          @id @default(uuid())
  name           String
  establishments Establishment[]
  users          User[]
  subscription   Subscription?
  auditLogs      AuditLog[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("organizations")
}

model Plan {
  id                String         @id @default(uuid())
  name              String // Starter, Business, Enterprise
  price             Decimal        @db.Decimal(12, 2)
  maxEstablishments Int            @map("max_establishments")
  maxUsers          Int            @map("max_users")
  features          String[]       @default([])
  subscriptions     Subscription[]

  @@map("plans")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique @map("organization_id")
  organization     Organization       @relation(fields: [organizationId], references: [id])
  planId           String             @map("plan_id")
  plan             Plan               @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIAL)
  currentPeriodEnd DateTime           @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  payments         SubscriptionPayment[]

  @@map("subscriptions")
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// Une tentative de paiement d'abonnement via Mobile Money (Airtel Money pour
// l'instant). Distinct du modèle Payment existant, qui concerne les
// encaissements clients au comptoir — deux univers métier différents.
model SubscriptionPayment {
  id               String                    @id @default(uuid())
  subscriptionId   String                    @map("subscription_id")
  subscription     Subscription              @relation(fields: [subscriptionId], references: [id])
  amount           Decimal                   @db.Decimal(12, 2)
  phone            String // numéro Mobile Money débité
  status           SubscriptionPaymentStatus @default(PENDING)
  externalRef      String?                   @unique @map("external_ref") // id de transaction côté Airtel
  providerResponse Json?                     @map("provider_response") // brut, utile pour le débogage
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@map("subscription_payments")
}

// ============================================================
// ÉTABLISSEMENTS & UTILISATEURS
// ============================================================

enum EstablishmentType {
  BAR
  RESTAURANT
  HOTEL
  GROSSISTE
  EPICERIE
}

model Establishment {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  type           EstablishmentType
  address        String?
  logo           String?
  users          User[]
  categories     Category[]
  products       Product[]
  tables         DiningTable[]
  orders         Order[]
  cashRegisters  CashRegister[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  expenseCategories ExpenseCategory[]
  expenses       Expense[]
  customers      Customer[]
  rooms          Room[]
  roomCategoryTaxes RoomCategoryTax[]
  stays          Stay[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("establishments")
}

// Correspond aux rôles du cahier des charges (section 4)
enum Role {
  OWNER // Propriétaire
  ADMIN // Administrateur / Manager
  CASHIER // Caissier
  SERVER // Serveur
  STOCK_KEEPER // Magasinier
  COOK // Cuisinier
}

model User {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  organization       Organization    @relation(fields: [organizationId], references: [id])
  // null = accès à tous les établissements de l'organisation (cas du propriétaire)
  establishmentId    String?         @map("establishment_id")
  establishment      Establishment?  @relation(fields: [establishmentId], references: [id])
  name               String
  email              String          @unique
  passwordHash       String          @map("password_hash")
  role               Role
  isActive           Boolean         @default(true) @map("is_active")
  // Accès transverse au tableau de bord plateforme (gestion des abonnements
  // de TOUTES les organisations) — indépendant du rôle par organisation
  // ci-dessus. Aucune UI ne permet de l'activer : à faire directement en
  // base (Prisma Studio) pour le tout premier administrateur plateforme.
  isPlatformAdmin    Boolean         @default(false) @map("is_platform_admin")
  orders             Order[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  expenses           Expense[]
  customerPayments   CustomerPayment[]
  cashSessionsOpened CashSession[]   @relation("OpenedBy")
  cashSessionsClosed CashSession[]   @relation("ClosedBy")
  auditLogs          AuditLog[]
  stays              Stay[]
  stayPayments       StayPayment[]
  orderVoids         OrderVoid[]
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

// ============================================================
// PRODUITS, CATÉGORIES & RECETTES
// ============================================================

// Où part un produit quand la commande est envoyée : cuisine (plats, écran
// Cuisine et bon de cuisine) ou bar (boissons, servies par le serveur, jamais
// affichées en cuisine)
enum PreparationArea {
  KITCHEN
  BAR
}

model Category {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String
  // Valeur par défaut des produits de la catégorie ; la changer met à jour
  // tous ses produits
  preparationArea PreparationArea @default(KITCHEN) @map("preparation_area")
  products        Product[]
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("categories")
}

enum Unit {
  UNIT
  G
  KG
  ML
  CL
  L
}

enum ProductType {
  VEGETARIEN
  SANS_SUCRE
  ALCOOLISE
  MUSULMAN
}

model Product {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  categoryId      String        @map("category_id")
  category        Category      @relation(fields: [categoryId], references: [id])
  name            String
  sku             String?
  sellingPrice    Decimal       @map("selling_price") @db.Decimal(12, 2)
  cost            Decimal       @default(0) @db.Decimal(12, 2)
  // Taxe optionnelle en % (ex. 18), ajoutée au prix de vente hors taxe à la vente
  tva             Decimal       @default(0) @db.Decimal(5, 2)
  unit            Unit          @default(UNIT)
  stockCurrent    Decimal       @default(0) @map("stock_current") @db.Decimal(10, 3)
  stockMin        Decimal       @default(0) @map("stock_min") @db.Decimal(10, 3)
  image           String?
  // Remise en pourcentage (0-100) appliquée sur sellingPrice, facultative.
  // Sans tagStartsAt/tagEndsAt, la remise s'applique tant que tag est renseigné ;
  // avec, elle n'est active que durant cette période (bornes incluses)
  tag             Decimal?      @db.Decimal(5, 2)
  tagStartsAt     DateTime?     @map("tag_starts_at") @db.Date
  tagEndsAt       DateTime?     @map("tag_ends_at") @db.Date
  type            ProductType?
  preparationArea PreparationArea @default(KITCHEN) @map("preparation_area")
  isActive        Boolean       @default(true) @map("is_active")

  // Recette : si ce produit est composé d'autres produits (ex. Poulet braisé -> Riz, Huile...)
  recipeItems    RecipeItem[]    @relation("ComposedProduct")
  // Dans quelles recettes ce produit est utilisé comme ingrédient
  usedInRecipes  RecipeItem[]    @relation("IngredientProduct")
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("products")
}

model RecipeItem {
  id                  String  @id @default(uuid())
  productId           String  @map("product_id") // le produit composé (ex. Poulet braisé)
  product             Product @relation("ComposedProduct", fields: [productId], references: [id])
  ingredientProductId String  @map("ingredient_product_id") // le produit consommé (ex. Riz)
  ingredientProduct   Product @relation("IngredientProduct", fields: [ingredientProductId], references: [id])
  quantity            Decimal @db.Decimal(10, 3) // dans l'unité de ingredientProduct

  @@unique([productId, ingredientProductId])
  @@map("recipe_items")
}

// ============================================================
// TABLES & COMMANDES (POS)
// ============================================================

enum TableStatus {
  FREE // 🟢 Libre
  OCCUPIED // 🔴 Occupée
  PENDING_ORDER // 🟠 Commande en attente
  BILL_REQUESTED // 🔵 Addition demandée
}

model DiningTable {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  label           String // ex. "T01"
  zone            String?
  status          TableStatus   @default(FREE)
  orders          Order[]

  @@map("tables")
}

// Correspond exactement au workflow décrit section 8 du cahier des charges
enum OrderStatus {
  BROUILLON
  EN_ATTENTE
  EN_PREPARATION
  PRETE
  SERVIE
  PAYEE
  FERMEE
  ANNULEE
}

model Order {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  tableId         String?       @map("table_id")
  table           DiningTable?  @relation(fields: [tableId], references: [id])
  userId          String        @map("user_id") // serveur / caissier qui a créé la commande
  user            User          @relation(fields: [userId], references: [id])
  customerName    String?       @map("customer_name")
  // Client enregistré (grossiste) — distinct de customerName (texte libre pour
  // un client de passage non enregistré). Nécessaire pour une vente à crédit :
  // impossible de créditer un compte client sans savoir lequel.
  customerId      String?       @map("customer_id")
  customer        Customer?     @relation(fields: [customerId], references: [id])
  // Hôtel : consommation mise "sur la chambre" (paiement ROOM), ajoutée à la
  // facture de ce séjour
  stayId          String?       @map("stay_id")
  stay            Stay?         @relation(fields: [stayId], references: [id])
  status          OrderStatus   @default(BROUILLON)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)

  items          OrderItem[]
  payments       Payment[]
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]
  cashMovements  CashMovement[]
  // Annulation / articles retirés après envoi en cuisine, avec motif
  voids          OrderVoid[]
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  @@map("orders")
}

enum OrderVoidType {
  ITEM // article retiré (tout ou partie d'une ligne)
  ORDER // commande entière annulée
}

// Journal des annulations et retraits — réservés au propriétaire et à
// l'administrateur, toujours avec un motif (« plat non apprécié »…)
model OrderVoid {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  order       Order         @relation(fields: [orderId], references: [id])
  type        OrderVoidType
  // Article retiré (ITEM) : nom figé et quantité
  productName String?       @map("product_name")
  quantity    Int?
  // Montant non facturé
  amount      Decimal       @db.Decimal(12, 2)
  reason      String
  // Déjà préparé : les ingrédients sont sortis du stock en PERTE
  wasPrepared Boolean       @default(false) @map("was_prepared")
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_voids")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2) // prix figé au moment de la vente
  // Taxe du produit (%) figée au moment de l'ajout, ajoutée au prix hors taxe
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  note      String?

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")

  @@map("order_status_history")
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  TRANSFER
  CREDIT
  // Hôtel : consommation imputée à la chambre d'un client en séjour, réglée
  // au départ avec la facture de séjour (aucun argent ne change de mains ici)
  ROOM
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String        @map("order_id")
  order     Order         @relation(fields: [orderId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

// ============================================================
// STOCK
// ============================================================

enum StockMovementType {
  ENTREE
  SORTIE_VENTE
  PERTE
  CASSE
  AJUSTEMENT
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String            @map("product_id")
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(10, 3) // toujours positive ; le sens est donné par "type"
  stockBefore Decimal           @map("stock_before") @db.Decimal(10, 3)
  stockAfter  Decimal           @map("stock_after") @db.Decimal(10, 3)
  orderId     String?           @map("order_id") // rempli si déclenché automatiquement par une vente
  order       Order?            @relation(fields: [orderId], references: [id])
  purchaseOrderId String?       @map("purchase_order_id") // rempli si déclenché par la réception d'un achat
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  reason      String?
  userId      String?           @map("user_id")
  user        User?             @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now()) @map("created_at")

  @@map("stock_movements")
}

// ============================================================
// FOURNISSEURS & ACHATS (V2)
// ============================================================

model Supplier {
  id              String          @id @default(uuid())
  establishmentId String          @map("establishment_id")
  establishment   Establishment   @relation(fields: [establishmentId], references: [id])
  name            String
  phone           String?
  email           String?
  address         String?
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

// BROUILLON -> COMMANDE -> RECU (déclenche les entrées de stock), ou ANNULE
enum PurchaseOrderStatus {
  BROUILLON
  COMMANDE
  RECU
  ANNULE
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  establishmentId String              @map("establishment_id")
  establishment   Establishment       @relation(fields: [establishmentId], references: [id])
  supplierId      String              @map("supplier_id")
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id])
  status          PurchaseOrderStatus @default(BROUILLON)
  subtotal        Decimal             @default(0) @db.Decimal(12, 2)
  discount        Decimal             @default(0) @db.Decimal(12, 2)
  tax             Decimal             @default(0) @db.Decimal(12, 2)
  total           Decimal             @default(0) @db.Decimal(12, 2)
  receivedAt      DateTime?           @map("received_at")
  items           PurchaseItem[]
  stockMovements  StockMovement[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model PurchaseItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String        @map("product_id")
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(10, 3)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)

  @@map("purchase_items")
}

// ============================================================
// CAISSE
// ============================================================

model CashRegister {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String // ex. "Caisse #01"
  sessions        CashSession[]

  @@map("cash_registers")
}

model CashSession {
  id                 String       @id @default(uuid())
  cashRegisterId     String       @map("cash_register_id")
  cashRegister       CashRegister @relation(fields: [cashRegisterId], references: [id])
  openedById         String       @map("opened_by_id")
  openedBy           User         @relation("OpenedBy", fields: [openedById], references: [id])
  openedAt           DateTime     @default(now()) @map("opened_at")
  openingBalance     Decimal      @map("opening_balance") @db.Decimal(12, 2)
  closedById         String?      @map("closed_by_id")
  closedBy           User?        @relation("ClosedBy", fields: [closedById], references: [id])
  closedAt           DateTime?    @map("closed_at")
  theoreticalBalance Decimal?     @map("theoretical_balance") @db.Decimal(12, 2)
  actualBalance      Decimal?     @map("actual_balance") @db.Decimal(12, 2)
  discrepancy        Decimal?     @db.Decimal(12, 2)
  movements          CashMovement[]

  @@map("cash_sessions")
}

enum CashMovementType {
  SALE_CASH
  SALE_CARD
  SALE_MOBILE_MONEY
  EXPENSE
  REFUND
  ADJUSTMENT
}

model CashMovement {
  id            String           @id @default(uuid())
  cashSessionId String           @map("cash_session_id")
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id])
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  orderId       String?          @map("order_id")
  order         Order?           @relation(fields: [orderId], references: [id])
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")

  @@map("cash_movements")
}

// ============================================================
// AUDIT (traçabilité des actions sensibles — section 23)
// ============================================================

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @map("user_id")
  user           User?        @relation(fields: [userId], references: [id])
  action         String // ex. "suppression produit commande #452"
  entityType     String?      @map("entity_type")
  entityId       String?      @map("entity_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ============================================================
// CLIENTS À CRÉDIT (module Grossiste)
// ============================================================

// Un client enregistré d'un grossiste (ex. un bar qui achète ses caisses de
// boissons). Permet la vente à crédit : le solde s'incrémente à chaque vente
// payée en mode CREDIT, et se décrémente à chaque règlement enregistré.
model Customer {
  id              String            @id @default(uuid())
  establishmentId String            @map("establishment_id")
  establishment   Establishment     @relation(fields: [establishmentId], references: [id])
  name            String
  phone           String?
  address         String?
  creditLimit     Decimal?          @map("credit_limit") @db.Decimal(12, 2)
  // Solde dû par le client — positif = le client doit de l'argent à l'établissement.
  // Mis à jour par payment.service.ts (vente à crédit), hotel.controller.ts
  // (séjour mis sur le compte) et customer.controller.ts (règlement reçu),
  // jamais modifié directement ailleurs.
  balance         Decimal           @default(0) @db.Decimal(12, 2)
  isActive        Boolean           @default(true) @map("is_active")
  orders          Order[]
  payments        CustomerPayment[]
  // Séjours (ou parts de séjour) mis sur le compte — méthode CREDIT
  stayPayments    StayPayment[]
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("customers")
}

// Un règlement reçu d'un client, qui réduit son solde dû
model CustomerPayment {
  id         String        @id @default(uuid())
  customerId String        @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  note       String?
  userId     String?       @map("user_id")
  user       User?         @relation(fields: [userId], references: [id])
  createdAt  DateTime      @default(now()) @map("created_at")

  @@map("customer_payments")
}

// ============================================================
// DÉPENSES (V2)
// ============================================================

model ExpenseCategory {
  id              String    @id @default(uuid())
  establishmentId String    @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  name            String // ex. Électricité, Eau, Transport, Maintenance, Autres
  expenses        Expense[]
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("expense_categories")
}

model Expense {
  id                String          @id @default(uuid())
  establishmentId   String          @map("establishment_id")
  establishment     Establishment   @relation(fields: [establishmentId], references: [id])
  expenseCategoryId String          @map("expense_category_id")
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  note              String?
  userId            String?         @map("user_id")
  user              User?           @relation(fields: [userId], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("expenses")
}

// ===================================================================
// Hôtel
// ===================================================================

enum RoomCategory {
  STANDARD
  VIP
  SUITE
}

// État physique de la chambre (plan des chambres). Passe automatiquement à
// OCCUPIED à l'arrivée et à CLEANING au départ ; AVAILABLE et OUT_OF_SERVICE
// se règlent à la main (ménage terminé, travaux…).
enum RoomStatus {
  AVAILABLE
  OCCUPIED
  CLEANING
  OUT_OF_SERVICE
}

model Room {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  number          String
  category        RoomCategory  @default(STANDARD)
  floor           String?
  capacity        Int           @default(2)
  nightlyRate     Decimal       @map("nightly_rate") @db.Decimal(12, 2)
  status          RoomStatus    @default(AVAILABLE)
  notes           String?
  // Chambre retirée de la vente sans perdre son historique de séjours
  isActive        Boolean       @default(true) @map("is_active")
  stays           Stay[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([establishmentId, number])
  @@map("rooms")
}

// Taxe de séjour : montant fixe par nuit et par chambre, selon le type de
// chambre. Recopiée dans le séjour à la réservation (un changement de barème
// ne modifie pas les séjours déjà enregistrés).
model RoomCategoryTax {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  category        RoomCategory
  taxPerNight     Decimal       @default(0) @map("tax_per_night") @db.Decimal(12, 2)
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([establishmentId, category])
  @@map("room_category_taxes")
}

enum StayStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Stay {
  id              String        @id @default(uuid())
  establishmentId String        @map("establishment_id")
  establishment   Establishment @relation(fields: [establishmentId], references: [id])
  roomId          String        @map("room_id")
  room            Room          @relation(fields: [roomId], references: [id])
  guestName       String        @map("guest_name")
  guestPhone      String?       @map("guest_phone")
  // Pièce d'identité (fiche de police)
  guestIdNumber   String?       @map("guest_id_number")
  adults          Int           @default(1)
  children        Int           @default(0)
  // Dates prévues (jour d'arrivée, jour de départ)
  checkInDate     DateTime      @map("check_in_date") @db.Date
  checkOutDate    DateTime      @map("check_out_date") @db.Date
  // Heures réelles d'arrivée et de départ
  checkedInAt     DateTime?     @map("checked_in_at")
  checkedOutAt    DateTime?     @map("checked_out_at")
  // Tarif et taxe figés à la réservation
  nightlyRate     Decimal       @map("nightly_rate") @db.Decimal(12, 2)
  taxPerNight     Decimal       @default(0) @map("tax_per_night") @db.Decimal(12, 2)
  status          StayStatus    @default(RESERVED)
  notes           String?
  userId          String        @map("user_id") // réceptionniste qui a créé le séjour
  user            User          @relation(fields: [userId], references: [id])
  payments        StayPayment[]
  // Consommations du bar/restaurant mises sur la chambre
  orders          Order[]
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([establishmentId, checkInDate])
  @@index([roomId, status])
  @@map("stays")
}

// Versement sur un séjour : acompte à la réservation ou à l'arrivée, solde au
// départ — autant que nécessaire. Jamais ROOM (c'est l'inverse d'un paiement).
model StayPayment {
  id        String        @id @default(uuid())
  stayId    String        @map("stay_id")
  stay      Stay          @relation(fields: [stayId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  note      String?
  // Méthode CREDIT : compte client débité (entreprise, client habitué…)
  customerId String?      @map("customer_id")
  customer   Customer?    @relation(fields: [customerId], references: [id])
  userId    String        @map("user_id")
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("stay_payments")
}
